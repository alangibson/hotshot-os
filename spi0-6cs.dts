/dts-v1/;
/plugin/;

/* See https://www.raspberrypi.org/forums/viewtopic.php?p=1852392#p1471583 */

/ {
	compatible = "brcm,bcm2835";

	fragment@0 {
		target = <&spi0_cs_pins>;
		frag0: __overlay__ {
			brcm,pins = <8 7 19 1 22 23>; /* header pins 24, 26, 35, 28, 15, 16 */
			brcm,function = <1>;     /* out */
		};
	};

	fragment@1 {
		target = <&spi0>;
		frag1: __overlay__ {
			#address-cells = <1>;
			#size-cells = <0>;

			cs-gpios = <&gpio 8 1>, <&gpio 7 1>, <&gpio 19 1>,
				   <&gpio 1 1>, <&gpio 22 1>, <&gpio 23 1>;
			status = "okay";

			spidev0_2: spidev@2 {
				compatible = "spidev";
				reg = <2>;	/* CE2 */
				#address-cells = <1>;
				#size-cells = <0>;
				spi-max-frequency = <125000000>;
			};

			spidev0_3: spidev@3 {
				compatible = "spidev";
				reg = <3>;	/* CE3 */
				#address-cells = <1>;
				#size-cells = <0>;
				spi-max-frequency = <125000000>;
			};

			spidev0_4: spidev@4 {
				compatible = "spidev";
				reg = <4>;	/* CE4 */
				#address-cells = <1>;
				#size-cells = <0>;
				spi-max-frequency = <125000000>;
			};

			spidev0_5: spidev@5 {
				compatible = "spidev";
				reg = <5>;	/* CE5 */
				#address-cells = <1>;
				#size-cells = <0>;
				spi-max-frequency = <125000000>;
			};
		};
	};

	__overrides__ {
		cs0_pin  = <&frag0>,"brcm,pins:0",
			   <&frag1>,"cs-gpios:4";
		cs1_pin  = <&frag0>,"brcm,pins:4",
			   <&frag1>,"cs-gpios:16";
		cs2_pin  = <&frag0>,"brcm,pins:8",
			   <&frag1>,"cs-gpios:28";
		cs3_pin  = <&frag0>,"brcm,pins:12",  /* Offset 4*CS into brcm pins array */
			   <&frag1>,"cs-gpios:40";   /* Offset 12*CS+4 into the cs-gpios array of structs */
		cs4_pin  = <&frag0>,"brcm,pins:16",
			   <&frag1>,"cs-gpios:52";
		cs5_pin  = <&frag0>,"brcm,pins:20",
			   <&frag1>,"cs-gpios:64";
		/* See https://www.raspberrypi.org/forums/viewtopic.php?p=1852392#p1850334 */
		cs2_spidev = <&spidev0_2>, "status";
		cs3_spidev = <&spidev0_3>, "status";
		cs4_spidev = <&spidev0_4>, "status";
		cs5_spidev = <&spidev0_5>, "status";
	};
};
