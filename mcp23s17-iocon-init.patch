+#define MCP23S17_IOCON_BANK	BIT(7)
+#define MCP23S17_IOCON_SEQOP	BIT(5)
+#define MCP23S17_IOCON_HAEN	BIT(3)
+#define MCP23S17_IOCON		0x05
+#define MCP23S17_IOCONB_BANK0	0x0b
