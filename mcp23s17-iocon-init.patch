 };
 
+static int mcp23s17_spi_write_reg8(struct spi_device *spi, unsigned int addr,
+				   u8 reg, u8 val)
+{
+	u8 tx[] = { 0x40 | ((addr & 0x07) << 1), reg, val };
+
+	return spi_write(spi, tx, sizeof(tx));
+}
+
+static int mcp23s17_spi_force_sequential_iocon(struct spi_device *spi,
+					       unsigned int addr)
+{
+	const u8 desired = MCP23S17_IOCON_HAEN;
+	int ret;
+
+	/*
+	 * IOCON.BANK changes the register map immediately. Force BANK=1
+	 * through the BANK=0 IOCONB address first; if the chip is already in
+	 * BANK=1 this write targets an unused address and is harmless. Then
+	 * write the desired IOCON value through the BANK=1 IOCON address,
+	 * which returns the chip to BANK=0 before regmap starts using the
+	 * sequential register layout.
+	 *
+	 * HAEN may still be disabled, in which case every MCP23S17 responds
+	 * only to hardware address 0. Send the sequence to address 0 first,
+	 * then to the requested address for devices that already have HAEN set.
+	 */
+	ret = mcp23s17_spi_write_reg8(spi, 0, MCP23S17_IOCONB_BANK0,
+				      MCP23S17_IOCON_BANK);
+	if (ret)
+		return ret;
+
+	ret = mcp23s17_spi_write_reg8(spi, 0, MCP23S17_IOCON, desired);
+	if (ret || addr == 0)
+		return ret;
+
+	ret = mcp23s17_spi_write_reg8(spi, addr, MCP23S17_IOCONB_BANK0,
+				      MCP23S17_IOCON_BANK);
+	if (ret)
+		return ret;
+
+	return mcp23s17_spi_write_reg8(spi, addr, MCP23S17_IOCON, desired);
+}
